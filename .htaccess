Options -MultiViews
RewriteEngine On

# This site is static and has no submission endpoints; reject write requests.
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$ [NC]
RewriteRule ^ - [R=405,L]

ErrorDocument 404 /404/index.html
ErrorDocument 500 /500/index.html

# Keep canonical error-page URLs while preserving their HTTP status codes.
RewriteRule ^404/?$ - [R=404,L]
RewriteRule ^500/?$ - [R=500,L]

# Si piden /terms/ con barra, redirige a /terms (para limpiar la URL)
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# Si el usuario entra a /terms, busca la carpeta y lee el index.html de adentro
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^([^/]+)$ /$1/index.html [L]