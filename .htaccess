Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# This site is static and has no submission endpoints; reject write requests.
RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$ [NC]
RewriteRule ^ - [R=405,L]

ErrorDocument 404 /404/index.html
ErrorDocument 500 /500/index.html

# Keep direct error-page routes at their requested URL and preserve their status.
RewriteRule ^404/?$ - [R=404,L]
RewriteRule ^500/?$ - [R=500,L]

# Redirect legacy .html requests to clean extensionless URLs.
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [R=301,L]

# Resolve clean, single-segment URLs to their folder index.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^([^/]+)$ /$1/index.html [L]